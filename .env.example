# Copy this file to .env for local development.
# Free key: https://developers.giphy.com -> Create an App -> API key (no card needed).
# On Render, set GIPHY_API_KEY in your service's Environment Variables instead.
GIPHY_API_KEY=your_giphy_api_key_here

# Optional: YouTube Data API v3 key, only used if keyless search stops working.
# YOUTUBE_API_KEY=
